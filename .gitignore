# Segredos — NUNCA versionar
functions/.env
functions/.env.*
*-service-account*.json
*serviceAccountKey*.json
.firebaserc.local
# Senhas das extensões (ex.: senha de app do Gmail usada pelo envio
# de e-mail). O .env da extensão carrega a senha dentro da URI de
# conexão SMTP, então ele também fica de fora do repositório.
# Ver extensions/firestore-send-email.env.exemplo pra estrutura.
extensions/*.secret.local
extensions/*.env

# Dependências
functions/node_modules/
node_modules/

# Logs e cache do Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Sistema
.DS_Store
Thumbs.db
