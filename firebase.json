{
  "hosting": {
    "site": "psicoworking",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|png|jpg|jpeg|svg|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/privacidade",
        "destination": "/privacidade/index.html"
      },
      {
        "source": "/entrar",
        "destination": "/psi/admin/index.html"
      },
      {
        "source": "/plataforma",
        "destination": "/psi/matriz/index.html"
      },
      {
        "source": "/cadastro",
        "destination": "/psi/cadastro/index.html"
      },
      {
        "source": "/*/equipe",
        "destination": "/psi/admin/index.html"
      },
      {
        "source": "/*",
        "destination": "/psi/paciente/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22"
    }
  ],
  "extensions": {
    "firestore-send-email": "firebase/firestore-send-email@0.2.5"
  }
}
