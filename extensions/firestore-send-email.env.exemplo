# Modelo da configuração da extensão de envio de e-mail.
# O arquivo real (firestore-send-email.env) tem a senha dentro da URI
# e por isso NÃO vai pro repositório — copie este modelo, preencha e
# renomeie pra firestore-send-email.env.
#
# A senha é uma "senha de app" do Gmail (conta com verificação em
# duas etapas ativada), gerada em myaccount.google.com/apppasswords.
# O @ do e-mail precisa virar %40 dentro da URI.

LOCATION=southamerica-east1
DATABASE_REGION=southamerica-east1
FIRESTORE_INSTANCE_ID=(default)
MAIL_COLLECTION=clinica_emails
AUTH_TYPE=UsernamePassword
SMTP_CONNECTION_URI=smtps://USUARIO%40DOMINIO.com.br:SENHA_DE_APP@smtp.gmail.com:465
DEFAULT_FROM=USUARIO@DOMINIO.com.br
DEFAULT_REPLY_TO=USUARIO@DOMINIO.com.br
TTL_EXPIRE_TYPE=never
