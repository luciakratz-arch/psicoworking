// ═══════════════════════════════════════════════════════════════
//  REGRAS DE SEGURANÇA DO BANCO DE DADOS — PsiCoWorking
//
//  PRINCÍPIO: o isolamento entre clínicas (psi_id) e o controle de
//  papel de cada pessoa (role) NUNCA são decididos por um campo que
//  o navegador do usuário escreve. São decididos pelo "carimbo"
//  (custom claim) do login de cada pessoa, carimbo esse que só a
//  Cloud Function (functions/index.js) pode colocar — o navegador
//  nunca tem esse poder.
// ═══════════════════════════════════════════════════════════════

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funções auxiliares ──────────────────────────────────────
    function estaLogado() {
      return request.auth != null;
    }

    function carimboClinica() {
      return request.auth.token.psi_id;
    }

    function carimboPapel() {
      return request.auth.token.role; // 'admin_matriz' | 'psi' | 'secretaria' | 'paciente'
    }

    function ehAdminMatriz() {
      return estaLogado() && carimboPapel() == 'admin_matriz';
    }

    function ehEquipeDaClinica(psiId) {
      return estaLogado()
        && carimboClinica() == psiId
        && (carimboPapel() == 'psi' || carimboPapel() == 'secretaria');
    }

    // Situação comercial da clínica (coleção psi_assinaturas, só a administradora grava).
    // Em período "somente leitura" ou "suspensa" a equipe consulta e exporta, mas não grava.
    // Clínica sem documento de assinatura (legado) continua podendo gravar.
    function assinaturaPermiteEscrita(psiId) {
      return !exists(/databases/$(database)/documents/psi_assinaturas/$(psiId))
        || get(/databases/$(database)/documents/psi_assinaturas/$(psiId)).data.situacao in ['teste', 'ativa', 'atrasada'];
    }

    function ehEquipeEscrevendo(psiId) {
      return ehEquipeDaClinica(psiId) && assinaturaPermiteEscrita(psiId);
    }

    // Equipe da clínica dona do documento. Ao ATUALIZAR, o carimbo psi_id
    // não pode ser trocado: senão a equipe de uma clínica poderia empurrar
    // dados para dentro de outra clínica.
    function ehEquipeMantendoClinica() {
      return ehEquipeDaClinica(resource.data.psi_id)
        && (request.method != "update" || request.resource.data.psi_id == resource.data.psi_id)
        && (request.method == "get" || request.method == "list" || assinaturaPermiteEscrita(resource.data.psi_id));
    }

    // Só a PSICÓLOGA da clínica (não a secretária): prontuário, crises e perfil
    // clínico são sigilo profissional (Resolução CFP 06/2019).
    function ehPsicologaDaClinica(psiId) {
      return estaLogado()
        && carimboClinica() == psiId
        && carimboPapel() == 'psi';
    }

    function ehPsicologaEscrevendo(psiId) {
      return ehPsicologaDaClinica(psiId) && assinaturaPermiteEscrita(psiId);
    }

    function ehPsicologaMantendoClinica() {
      return ehPsicologaDaClinica(resource.data.psi_id)
        && (request.method != "update" || request.resource.data.psi_id == resource.data.psi_id)
        && (request.method == "get" || request.method == "list" || assinaturaPermiteEscrita(resource.data.psi_id));
    }

    function ehDonoPaciente(psiId, pacienteId) {
      return estaLogado()
        && carimboPapel() == 'paciente'
        && carimboClinica() == psiId
        && request.auth.uid == pacienteId;
    }

    // Equipe de QUALQUER clínica (sem checar psi_id) — usada só para
    // a biblioteca de recursos terapêuticos, que é compartilhada por
    // toda a plataforma (não é dado de uma clínica só).
    function ehEquipeDeAlgumaClinica() {
      return estaLogado() && (carimboPapel() == 'psi' || carimboPapel() == 'secretaria');
    }

    // ── Cadastro dos psicólogos (vitrine pública) ───────────────
    match /psi_profiles/{psiId} {
      allow read: if true; // nome, foto, especialidade — nada de paciente aqui
      allow write: if ehAdminMatriz();
    }

    // ── Personalização do site do psicólogo ─────────────────────
    match /psi_config/{psiId} {
      allow read: if true;
      allow write: if ehAdminMatriz() || ehEquipeDaClinica(psiId);
    }

    // ── Depoimentos anônimos ─────────────────────────────────────
    match /psi_depoimentos/{depoimentoId} {
      allow read: if resource.data.aprovado == true;
      allow create: if estaLogado() && carimboPapel() == 'paciente'
                    && request.resource.data.psi_id == carimboClinica()
                    && request.resource.data.keys().hasOnly(['psi_id','estrelas','texto','aprovado','criadoEm'])
                    && request.resource.data.aprovado == false;
      allow update: if ehEquipeDaClinica(resource.data.psi_id);
      allow delete: if ehAdminMatriz() || ehEquipeDaClinica(resource.data.psi_id);
    }

    // ── Dados clínicos sensíveis: cada um só vê o que é seu ─────
    match /clinica_pacientes/{pacienteId} {
      allow read, write: if ehEquipeMantendoClinica()
                          || (request.method == 'create' && ehEquipeEscrevendo(request.resource.data.psi_id));
      allow read: if ehDonoPaciente(resource.data.psi_id, pacienteId);
      // O paciente edita só os próprios dados pessoais e a foto. E-mail, status,
      // clínica, responsável e vínculos continuam sendo da equipe.
      allow update: if ehDonoPaciente(resource.data.psi_id, pacienteId)
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fotoUrl', 'atualizadoEm', 'nome', 'telefone', 'dataNasc', 'cpf', 'genero'])
                     && request.resource.data.nome is string
                     && request.resource.data.nome.size() >= 2
                     && request.resource.data.nome.size() <= 120
                     && request.resource.data.get('telefone', '') is string
                     && request.resource.data.get('telefone', '').size() <= 40
                     && request.resource.data.get('cpf', '') is string
                     && request.resource.data.get('cpf', '').size() <= 20;
    }

    match /clinica_sessoes/{sessaoId} {
      allow read, write: if ehEquipeMantendoClinica()
                          || (request.method == 'create' && ehEquipeEscrevendo(request.resource.data.psi_id));
      // Paciente vê as próprias sessões (Próxima Sessão no Painel) e
      // pode confirmar presença (atualiza só o status de confirmação).
      allow read: if ehDonoPaciente(resource.data.psi_id, resource.data.pacienteId);
      // O paciente só pode confirmar presença; valores, status e datas são da equipe.
      allow update: if ehDonoPaciente(resource.data.psi_id, resource.data.pacienteId)
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statusConfirmacao', 'confirmadoEm'])
                     && request.resource.data.statusConfirmacao == 'confirmado';
    }

    match /clinica_pacotes/{pacoteId} {
      allow read, write: if ehEquipeMantendoClinica()
                          || (request.method == 'create' && ehEquipeEscrevendo(request.resource.data.psi_id));
    }

    match /clinica_lancamentos/{lancId} {
      // financeiro: paciente nunca acessa
      allow read, write: if ehEquipeMantendoClinica()
                          || (request.method == 'create' && ehEquipeEscrevendo(request.resource.data.psi_id));
    }

    match /clinica_metas/{metaId} {
      allow read, write: if ehEquipeMantendoClinica()
                          || (request.method == 'create' && ehEquipeEscrevendo(request.resource.data.psi_id));
      allow read: if ehDonoPaciente(resource.data.psi_id, resource.data.pacienteId);
      // O paciente só atualiza o andamento da meta (progresso 0 a 100), nunca título nem dono.
      allow update: if ehDonoPaciente(resource.data.psi_id, resource.data.pacienteId)
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['progresso', 'status', 'atualizadoPor', 'atualizadoEm'])
                     && request.resource.data.progresso is number
                     && request.resource.data.progresso >= 0
                     && request.resource.data.progresso <= 100;
    }

    match /clinica_laudos/{laudoId} {
      allow read, write: if ehEquipeMantendoClinica()
                          || (request.method == 'create' && ehEquipeEscrevendo(request.resource.data.psi_id));
      // O paciente só lê o que a psicóloga liberou de propósito.
      allow read: if ehDonoPaciente(resource.data.psi_id, resource.data.pacienteId)
                   && resource.data.visivelPaciente == true;
    }

    // Relatórios e declarações de Saúde Ocupacional (NR-1): só a equipe.
    match /clinica_documentos_nr1/{docId} {
      allow read, write: if ehEquipeMantendoClinica()
                          || (request.method == 'create' && ehEquipeEscrevendo(request.resource.data.psi_id));
    }

    match /clinica_anamneses/{registroId} {
      allow read, write: if ehEquipeMantendoClinica();
      // O paciente lê só os próprios registros (exportação e histórico no portal).
      allow read: if ehDonoPaciente(resource.data.psi_id, resource.data.pacienteId);
      allow read, create: if estaLogado() && carimboPapel() == 'paciente'
                           && request.resource.data.psi_id == carimboClinica()
                           && request.resource.data.pacienteId == request.auth.uid;
    }

    // Rastreamentos DSM-5 (jogos, dependência química, e os que forem
    // sendo portados depois). Só chegam por link público — a Cloud
    // Function salvarAtividadePublica grava com o Admin SDK, então
    // aqui só precisa de regra de leitura/edição pra equipe da clínica.
    match /clinica_rastreamento_jogos/{registroId} {
      allow read, write: if ehEquipeMantendoClinica();
    }
    match /clinica_rastreamento_dependencia/{registroId} {
      allow read, write: if ehEquipeMantendoClinica();
    }
    match /clinica_rastreamento_bipolar/{registroId} {
      allow read, write: if ehEquipeMantendoClinica();
    }
    match /clinica_rastreamento_alimentar/{registroId} {
      allow read, write: if ehEquipeMantendoClinica();
      // O paciente lê só os próprios registros (exportação e histórico no portal).
      allow read: if ehDonoPaciente(resource.data.psi_id, resource.data.pacienteId);
    }
    match /clinica_rastreamento_sexual/{registroId} {
      allow read, write: if ehEquipeMantendoClinica();
    }
    match /clinica_rastreamento_neuro/{registroId} {
      allow read, write: if ehEquipeMantendoClinica();
    }

    match /clinica_tcc/{registroId} {
      allow read, write: if ehEquipeMantendoClinica();
      // O paciente lê só os próprios registros (exportação e histórico no portal).
      allow read: if ehDonoPaciente(resource.data.psi_id, resource.data.pacienteId);
      allow read, create: if estaLogado() && carimboPapel() == 'paciente'
                           && request.resource.data.psi_id == carimboClinica()
                           && request.resource.data.pacienteId == request.auth.uid;
    }

    match /clinica_humor/{registroId} {
      allow read, write: if ehEquipeMantendoClinica();
      // O paciente lê só os próprios registros (exportação e histórico no portal).
      allow read: if ehDonoPaciente(resource.data.psi_id, resource.data.pacienteId);
      allow read, create: if estaLogado() && carimboPapel() == 'paciente'
                           && request.resource.data.psi_id == carimboClinica()
                           && request.resource.data.pacienteId == request.auth.uid;
    }

    match /clinica_diario/{registroId} {
      // diário terapêutico: só o próprio paciente escreve; psi só lê
      allow read, write: if ehDonoPaciente(resource.data.psi_id, resource.data.pacienteId);
      allow read: if ehEquipeDaClinica(resource.data.psi_id);
    }

    match /clinica_recursos/{recursoId} {
      allow read: if estaLogado();
      allow write: if ehAdminMatriz() || ehEquipeDaClinica(resource.data.psi_id);
    }

    match /clinica_fabulas/{id} {
      allow read: if estaLogado();
      allow write: if ehAdminMatriz();
    }

    match /clinica_psicoeducacao/{id} {
      allow read: if estaLogado();
      allow write: if ehAdminMatriz();
    }

    match /clinica_recurso_acessos/{logId} {
      allow create: if estaLogado() && request.resource.data.psi_id == carimboClinica();
      allow read: if ehEquipeDaClinica(resource.data.psi_id) || ehAdminMatriz();
      allow update, delete: if false; // registro de uso nunca é editado ou apagado
    }

    match /clinica_gestao_ansiedade/{id} {
      allow read, write: if ehEquipeMantendoClinica();
      // O paciente lê só os próprios registros (exportação e histórico no portal).
      allow read: if ehDonoPaciente(resource.data.psi_id, resource.data.pacienteId);
      allow read, create: if estaLogado() && carimboPapel() == 'paciente'
                           && request.resource.data.psi_id == carimboClinica();
    }

    match /clinica_arvore_decisao/{id} {
      allow read, write: if ehEquipeMantendoClinica();
      // O paciente lê só os próprios registros (exportação e histórico no portal).
      allow read: if ehDonoPaciente(resource.data.psi_id, resource.data.pacienteId);
      allow read, create: if estaLogado() && carimboPapel() == 'paciente'
                           && request.resource.data.psi_id == carimboClinica();
    }

    match /clinica_registro_abc/{id} {
      allow read, write: if ehEquipeMantendoClinica();
      // O paciente lê só os próprios registros (exportação e histórico no portal).
      allow read: if ehDonoPaciente(resource.data.psi_id, resource.data.pacienteId);
      allow read, create: if estaLogado() && carimboPapel() == 'paciente'
                           && request.resource.data.psi_id == carimboClinica();
    }

    match /clinica_relaxamento/{id} {
      allow read, write: if ehEquipeMantendoClinica();
      // O paciente lê só os próprios registros (exportação e histórico no portal).
      allow read: if ehDonoPaciente(resource.data.psi_id, resource.data.pacienteId);
      allow read, create: if estaLogado() && carimboPapel() == 'paciente'
                           && request.resource.data.psi_id == carimboClinica();
    }

    match /clinica_rastreamento_alimentar/{id} {
      allow read, write: if ehEquipeMantendoClinica();
      // O paciente lê só os próprios registros (exportação e histórico no portal).
      allow read: if ehDonoPaciente(resource.data.psi_id, resource.data.pacienteId);
      allow read, create: if estaLogado() && carimboPapel() == 'paciente'
                           && request.resource.data.psi_id == carimboClinica();
    }

    match /clinica_treino_auditivo/{id} {
      allow read, write: if ehEquipeMantendoClinica();
      // O paciente lê só os próprios registros (exportação e histórico no portal).
      allow read: if ehDonoPaciente(resource.data.psi_id, resource.data.pacienteId);
      allow read, create: if estaLogado() && carimboPapel() == 'paciente'
                           && request.resource.data.psi_id == carimboClinica();
    }

    // Baralho das Distorções: o paciente vai atualizando o MESMO
    // documento a cada sessão (guarda a hierarquia e quantas crenças
    // já trabalhou), por isso aqui ele também precisa de update.
    match /clinica_baralho_distorcoes/{id} {
      allow read, write: if ehEquipeMantendoClinica();
      allow read, update: if ehDonoPaciente(resource.data.psi_id, resource.data.pacienteId);
      allow create: if estaLogado() && carimboPapel() == 'paciente'
                     && request.resource.data.psi_id == carimboClinica()
                     && request.resource.data.pacienteId == request.auth.uid;
    }

    // ── Links de atividade enviados por WhatsApp ─────────────────
    // O id do documento É o token do link. Quem tem o link consegue
    // abrir aquele documento (allow get) e nada mais: listar a coleção
    // é proibido, então ninguém descobre links de outras pessoas
    // "chutando". O documento guarda uma cópia do material e o nome do
    // paciente — nunca dados sensíveis do prontuário.
    // Quem grava a RESPOSTA não é esta regra: é a Cloud Function
    // salvarAtividadePublica, que confere o token do lado do servidor.
    match /clinica_links_partilhados/{token} {
      allow get: if true;
      allow list: if ehEquipeDaClinica(resource.data.psi_id);
      allow create: if ehEquipeDeAlgumaClinica()
                     && request.resource.data.psi_id == carimboClinica();
      allow update, delete: if ehEquipeDaClinica(resource.data.psi_id);
    }

    // ── Tokens de rastreamento diagnóstico (7 Grupos DSM-5) ─────────
    // O paciente lê o token (sem login) para carregar a configuração do
    // questionário. A equipe cria. O paciente só pode marcar como "usado".
    match /clinica_rastreamento_tokens/{token} {
      allow get: if true;
      allow list: if ehEquipeDaClinica(resource.data.psi_id);
      allow create: if ehEquipeDeAlgumaClinica()
                    && request.resource.data.psi_id == carimboClinica();
      allow update: if ehEquipeDaClinica(resource.data.psi_id)
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usado'])
                        && request.resource.data.usado == true);
      allow delete: if ehEquipeDaClinica(resource.data.psi_id);
    }

    // ── Respostas do questionário diagnóstico (7 Grupos DSM-5) ──────
    // O paciente cria sem login; validamos que o token existe e que o
    // psi_id da resposta bate com o psi_id do token (cross-doc lookup).
    match /clinica_rastreamento_diagnostico/{registroId} {
      allow read, write: if ehEquipeMantendoClinica();
      allow create: if request.resource.data.token is string
                    && exists(/databases/$(database)/documents/clinica_rastreamento_tokens/$(request.resource.data.token))
                    && get(/databases/$(database)/documents/clinica_rastreamento_tokens/$(request.resource.data.token)).data.psi_id == request.resource.data.psi_id;
    }

    // ── Consentimentos LGPD ─────────────────────────────────────
    // O id do documento é o uid do paciente. O paciente lê e grava
    // o próprio consentimento; a equipe da clínica só lê.
    match /clinica_consentimentos/{uid} {
      allow read, write: if estaLogado() && request.auth.uid == uid;
      allow read: if ehEquipeDaClinica(resource.data.psi_id);
    }

    // ── Solicitações de direitos LGPD (exclusão, portabilidade) ──
    // O paciente cria a própria solicitação; a equipe lê e processa.
    match /clinica_solicitacoes_lgpd/{solicitacaoId} {
      allow create: if estaLogado() && carimboPapel() == 'paciente'
                    && request.resource.data.psi_id == carimboClinica()
                    && request.resource.data.uid == request.auth.uid;
      allow read: if estaLogado() && resource.data.uid == request.auth.uid;
      allow read, update: if ehEquipeDaClinica(resource.data.psi_id);
    }

    match /clinica_agenda/{eventoId} {
      allow read, write: if ehEquipeMantendoClinica()
                          || (request.method == 'create' && ehEquipeEscrevendo(request.resource.data.psi_id));
    }

    // ── Configurações financeiras internas (comissões etc.) — NUNCA
    // pública, ao contrário de psi_config. Doc id = psi_id.
    match /clinica_config/{psiId} {
      allow read, write: if ehEquipeDaClinica(psiId);
    }

    match /clinica_parceiras/{parceiraId} {
      allow read, write: if ehEquipeMantendoClinica()
                          || (request.method == 'create' && ehEquipeEscrevendo(request.resource.data.psi_id));
    }

    // ── Prontuários de sessões TCC (anotações clínicas por sessão) ──
    match /clinica_prontuarios/{id} {
      allow read, write: if ehPsicologaMantendoClinica()
                          || (request.method == 'create' && ehPsicologaEscrevendo(request.resource.data.psi_id));
    }

    // ── Crises registradas por paciente (medição de evolução) ──
    match /clinica_crises/{id} {
      allow read, write: if ehPsicologaMantendoClinica()
                          || (request.method == 'create' && ehPsicologaEscrevendo(request.resource.data.psi_id));
    }

    // ── Perfil clínico do paciente: CID, condições e medicações (1 doc por paciente) ──
    match /clinica_perfil_clinico/{id} {
      allow read, write: if ehPsicologaMantendoClinica()
                          || (request.method == 'create' && ehPsicologaEscrevendo(request.resource.data.psi_id));
    }

    // ── Plano de Ensino ABA (alvos de aquisição e de redução; 1 doc por paciente) ──
    // Sigilo igual ao do prontuário: só a psicóloga da clínica (nem a secretária, nem o paciente).
    match /clinica_aba_planos/{id} {
      allow read, write: if ehPsicologaMantendoClinica()
                          || (request.method == 'create' && ehPsicologaEscrevendo(request.resource.data.psi_id));
    }

    // ── Endereço de cada clínica: apelido (slug) -> psi_id ──
    // Leitura pública (só serve para mostrar a marca antes do login). Gravação só pelas
    // Cloud Functions (reservarSlug / definirSlugClinica), que garantem apelido único.
    match /psi_slugs/{slug} {
      allow read: if true;
      allow write: if false;
    }

    // ── Assinatura (plano, teste, cobrança, uso de IA) de cada clínica ──
    // Só a administradora da plataforma grava. A equipe da própria clínica lê, para
    // mostrar avisos de teste e do plano Plus. Contadores de IA são gravados pelas
    // Cloud Functions (que não passam por estas regras).
    match /psi_assinaturas/{psiId} {
      allow read: if ehAdminMatriz() || ehEquipeDaClinica(psiId);
      allow write: if ehAdminMatriz();
    }

    // ── Depoimentos de psicólogas para o site de vendas ──
    // Qualquer pessoa pode ENVIAR (sempre como não aprovado, com autorização marcada).
    // Só os aprovados pela administradora são públicos; ela revisa, edita e aprova.
    match /site_depoimentos/{id} {
      allow read: if resource.data.aprovado == true || ehAdminMatriz();
      allow create: if request.resource.data.keys().hasOnly(['nome', 'detalhe', 'texto', 'aprovado', 'autorizou', 'autorizouEm', 'criadoEm'])
                    && request.resource.data.aprovado == false
                    && request.resource.data.autorizou == true
                    && request.resource.data.nome is string && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 80
                    && request.resource.data.texto is string && request.resource.data.texto.size() >= 10 && request.resource.data.texto.size() <= 700
                    && request.resource.data.get('detalhe', '') is string && request.resource.data.get('detalhe', '').size() <= 80;
      allow update, delete: if ehAdminMatriz();
    }

    // ── Preços públicos para o site de vendas (cópia sem nada sensível) ──
    match /plataforma_publico/{docId} {
      allow read: if true;
      allow write: if ehAdminMatriz();
    }

    // ── Planos, preços e regras do teste (editados pela administradora) ──
    match /plataforma_config/{docId} {
      allow read: if ehAdminMatriz() || ehEquipeDeAlgumaClinica();
      allow write: if ehAdminMatriz();
    }

    // ── Pedido de mudança de plano feito pela psicóloga (um por clínica) ──
    // Ela só consegue pedir; quem aplica o plano e registra o pagamento é a administradora.
    match /psi_pedidos_plano/{psiId} {
      allow read: if ehAdminMatriz() || ehEquipeDaClinica(psiId);
      allow create, update: if ehPsicologaDaClinica(psiId)
                            && request.resource.data.keys().hasOnly(['psi_id', 'nomeClinica', 'de', 'para', 'ciclo', 'status', 'pedidoEm'])
                            && request.resource.data.psi_id == psiId
                            && request.resource.data.status == 'pendente'
                            && request.resource.data.para in ['essencial', 'plus']
                            && request.resource.data.ciclo in ['mensal', 'anual'];
      allow update, delete: if ehAdminMatriz();
    }

    match /clinica_comissoes/{comissaoId} {
      allow read, write: if ehEquipeMantendoClinica()
                          || (request.method == 'create' && ehEquipeEscrevendo(request.resource.data.psi_id));
    }

    match /clinica_orcamento_servicos/{servicoId} {
      allow read, write: if ehEquipeMantendoClinica()
                          || (request.method == 'create' && ehEquipeEscrevendo(request.resource.data.psi_id));
    }

    // ── Biblioteca de recursos terapêuticos — compartilhada por toda
    // a plataforma (não é psi_id, é conteúdo editorial da própria
    // PsiCoWorking, igual um "catálogo"). Qualquer pessoa logada lê
    // (paciente também, agora que o Portal do Paciente existe) — só
    // a equipe da clínica edita o catálogo.
    // Catálogo compartilhado: qualquer pessoa logada lê (paciente também),
    // mas só a Admin Matriz edita — o catálogo é editorial da plataforma,
    // não é conteúdo de uma clínica só.
    match /recursos_terapeuticos/{id} {
      allow read: if estaLogado();
      allow write: if ehAdminMatriz();
    }
    match /fabulas_terapeuticas/{id} {
      allow read: if estaLogado();
      allow write: if ehAdminMatriz();
    }
    match /psicoeducacao_conteudos/{id} {
      allow read: if estaLogado();
      allow write: if ehAdminMatriz();
    }

    // ── Reflexões escritas pelo paciente ao final de uma fábula ──
    match /clinica_reflexoes/{id} {
      allow read, write: if ehEquipeMantendoClinica();
      // O paciente lê só os próprios registros (exportação e histórico no portal).
      allow read: if ehDonoPaciente(resource.data.psi_id, resource.data.pacienteId);
      allow read, create: if estaLogado() && carimboPapel() == 'paciente'
                           && request.resource.data.psi_id == carimboClinica();
    }

    // ── Trilha de auditoria: só a Cloud Function grava, ninguém apaga ──
    match /clinica_audit_log/{logId} {
      allow read: if ehAdminMatriz();
      allow write: if false;
    }

    // ── Formulário de interesse (site institucional) ─────────────
    // Qualquer pessoa pode criar (sem login) — só a Admin Matriz lê.
    match /psi_interesse/{docId} {
      // Qualquer pessoa envia o pedido, mas só com os campos esperados e tamanhos
      // razoáveis (sem status, sem campos extras): evita lixo e preenchimento malicioso.
      allow create: if request.resource.data.keys().hasOnly(['nome', 'email', 'telefone', 'cidade', 'origem', 'crp', 'indicadoPor', 'aceitouPoliticaEm', 'criadoEm'])
                    && request.resource.data.nome is string && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 120
                    && request.resource.data.email is string && request.resource.data.email.size() <= 160
                    && request.resource.data.email.matches('.+@.+[.].+')
                    && request.resource.data.get('crp', '') is string && request.resource.data.get('crp', '').size() <= 20
                    && request.resource.data.get('telefone', '') is string && request.resource.data.get('telefone', '').size() <= 40
                    && request.resource.data.get('cidade', '') is string && request.resource.data.get('cidade', '').size() <= 80
                    && request.resource.data.get('indicadoPor', '') is string && request.resource.data.get('indicadoPor', '').size() <= 120;
      allow read, update, delete: if ehAdminMatriz();
    }

    // ── Tudo que não foi listado: bloqueado por padrão ──────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
